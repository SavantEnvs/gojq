//go:build go1.18

// mayhem harness — gojq query+interpreter: parse a jq QUERY, compile it, and
// RUN it over a fuzzer-supplied JSON document, driving the bytecode
// interpreter (execute.go) rather than only the lexer/parser/compiler (see
// harness_query_test.go.src for that shallower target). Deliberately close to
// upstream's own native fuzz target (FuzzQueryRun in query_test.go), but with
// TWO fuzzer-controlled inputs instead of one: the query text AND the JSON
// document it runs over (upstream always runs over a nil input), so the
// interpreter's value-handling paths (indexing, iteration, arithmetic on
// attacker-shaped JSON) get exercised, not just the query language surface.
//
// BOUNDED EXECUTION (interpreter-specific hazard — see the port brief): a
// query like `repeat(.)` or `range(1e18)` produces an effectively
// infinite/huge result stream. Two independent bounds, matching and
// tightening upstream's own approach:
//   - RunWithContext with a short, fixed deadline (upstream uses 100ms; we use
//     200ms to allow slightly deeper JSON documents to be walked).
//   - A hard cap on the number of results consumed (maxResults), so a
//     finite-but-huge generator (e.g. `range(100000000)`) that would outrun
//     the context deadline on a slow iteration path still can't buy unbounded
//     work per fuzz execution.
// Neither bound alone is sufficient: the context deadline is checked between
// interpreter steps (a single very expensive step could still run long), and
// the result cap alone would not stop a query that spins without producing
// output. Together they bound both dimensions.
//
// No file I/O: both the query and the JSON document come only from the
// fuzzer. go-118-fuzz-build splits its single input buffer into the two typed
// arguments (string, then []byte) via go-fuzz-headers. Seeds are supplied by
// Mayhem via the Mayhemfile `testsuite:` directive: this target's local seeds
// are JSON documents (mayhem/fuzz_query_run/testsuite/), distinct from
// fuzz_query's jq-program seeds.
//
// PACKAGE NOTE: `package gojq` (internal), not `gojq_test` — see the comment
// in harness_query_test.go.src: go-118-fuzz-build rewrites this file in
// place into an ordinary (non-_test.go) source file, and a directory can
// only hold one non-test package.
package gojq

import (
	"bytes"
	"context"
	"encoding/json"
	"testing"
	"time"
)

func FuzzMayhemQueryRun(f *testing.F) {
	f.Fuzz(func(t *testing.T, src string, input []byte) {
		if len(src) > 8192 || len(input) > 65536 {
			return
		}
		q, err := Parse(src)
		if err != nil {
			return
		}
		code, err := Compile(q)
		if err != nil {
			return
		}

		// Decode exactly one JSON value; ignore any trailing bytes rather than
		// erroring on them, since several upstream test fixtures are
		// whitespace-separated multi-document files. Malformed JSON is an
		// expected outcome (return), same as a query syntax error above.
		var v any
		if err := json.NewDecoder(bytes.NewReader(input)).Decode(&v); err != nil {
			return
		}

		ctx, cancel := context.WithTimeout(context.Background(), 200*time.Millisecond)
		defer cancel()
		iter := code.RunWithContext(ctx, v)
		const maxResults = 1000
		for i := 0; i < maxResults; i++ {
			if _, ok := iter.Next(); !ok {
				break
			}
		}
	})
}
